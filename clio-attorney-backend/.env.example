# Clio API Configuration
# Get these from your Clio Developer Account at https://developers.clio.com/
CLIO_CLIENT_ID=your_clio_client_id_here
CLIO_CLIENT_SECRET=your_clio_client_secret_here
CLIO_REDIRECT_URI=https://your-app.vercel.app/api/oauth/callback
CLIO_BASE_URL=https://app.clio.com
DEFAULT_SCOPE=read:bills read:matters read:time_entries read:users read:payments

# Vercel KV Configuration
# Get these from your Vercel KV database settings
KV_URL=your_kv_url_here
KV_REST_API_URL=your_kv_rest_api_url_here
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# Optional Configuration
CLIO_MAX_USER_PAGES=5

# Email Configuration (Optional - for notifications)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@yourcompany.com

# Debug Mode (Optional)
DEBUG=false