{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.{js,ts}": {
      "runtime": "@vercel/node@3.2.26"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/monthly?firmId=default",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/database/sync?firmId=default",
      "schedule": "0 */6 * * *"
    }
  ]
}